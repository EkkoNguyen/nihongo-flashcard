{
  "name": "kotoba-loop",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @nihongo/shared build && pnpm --parallel --filter @nihongo/web --filter @nihongo/api dev",
    "dev:web": "pnpm --filter @nihongo/shared build && pnpm --filter @nihongo/web dev",
    "dev:api": "pnpm --filter @nihongo/shared build && pnpm --filter @nihongo/api dev",
    "db:start": "pnpm --filter @nihongo/api db:start",
    "db:stop": "pnpm --filter @nihongo/api db:stop",
    "db:verify": "pnpm --filter @nihongo/api db:verify",
    "db:setup": "pnpm --filter @nihongo/api db:setup",
    "db:seed": "pnpm --filter @nihongo/api db:seed",
    "build": "pnpm --filter @nihongo/shared build && pnpm -r build",
    "typecheck": "pnpm --filter @nihongo/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @nihongo/shared build && pnpm -r test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,js,json}\" \"*.{json,yaml,yml,js}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,js,json}\" \"*.{json,yaml,yml,js}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
