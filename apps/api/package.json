{
  "name": "@nihongo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:start": "docker compose -f ../../compose.yaml up -d mongodb",
    "db:stop": "docker compose -f ../../compose.yaml stop mongodb",
    "db:setup": "tsx src/scripts/setup-db.ts",
    "db:verify": "tsx src/scripts/verify-db.ts",
    "db:seed": "tsx src/scripts/seed-dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.27",
    "@fastify/cors": "^11.1.0",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@nihongo/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "better-auth": "^1.7.27",
    "fastify": "^5.6.2",
    "mongodb": "^6.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14"
  }
}
